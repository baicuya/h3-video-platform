[Unit]
Description=Jinxiu H3 FastAPI backend
After=network-online.target postgresql.service redis-server.service h3-comfyui.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/workspace/h3-video-platform/backend
EnvironmentFile=/home/ubuntu/workspace/h3-video-platform/.env
ExecStart=/home/ubuntu/workspace/h3-video-platform/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

