[Unit]
Description=Jinxiu H3 ComfyUI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ComfyUI
ExecStart=/home/ubuntu/ComfyUI/.venv/bin/python main.py --listen 127.0.0.1 --port 8188 --disable-auto-launch --gpu-only --use-sage-attention
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
